{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "city": {
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "main": {
            "type": "object",
            "properties": {
              "temp": { "type": "number" },
              "pressure": { "type": "number" },
              "humidity": { "type": "number" }
            },
            "required": ["temp", "pressure", "humidity"]
          },
          "weather": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": { "type": "string" }
              },
              "required": ["description"]
            }
          }
        },
        "required": ["main", "weather"]
      }
    }
  },
  "required": ["city", "list"]
}

